# ─────────────────────────────────────────────────
# Production AI Research Agent — environment template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────

# ── Application ───────────────────────────────────
# Allowed values: development | production | testing
ENVIRONMENT=production

# Allowed values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────
# PostgreSQL example for production:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/research_agent

# ── LLM / API ─────────────────────────────────────
# Select LLM provider: openai | groq
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here

# Primary and fallback models
LLM_MODEL=llama3-70b-8192
LLM_FALLBACK_MODEL=mixtral-8x7b-32768

LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=60

# ── Agent Configuration ───────────────────────────
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_SECONDS=300
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60

# ── Vector database & RAG ─────────────────────────
VECTOR_STORE=chroma
EMBEDDING_PROVIDER=sentence_transformers
CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION_NAME=research_agent

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

# ── Tools ─────────────────────────────────────────
WEB_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8080

# ── Resilience ────────────────────────────────────
MAX_RETRIES=3

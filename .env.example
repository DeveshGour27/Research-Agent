# ─────────────────────────────────────────────────
# Production AI Research Agent — environment template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────

# ── LLM / API ─────────────────────────────────────
# Select LLM provider: openai | groq
LLM_PROVIDER=groq

GROQ_API_KEY=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

# Primary and fallback models are both served by Groq using GROQ_API_KEY.
LLM_MODEL=qwen/qwen3.6-27b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=text-embedding-3-small

# ── Application ───────────────────────────────────
# Allowed values: development | production | testing
ENVIRONMENT=development

# Allowed values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Vector database ───────────────────────────────
CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION_NAME=research_agent

# ── RAG tuning ────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

# ── Resilience ────────────────────────────────────
MAX_RETRIES=3
